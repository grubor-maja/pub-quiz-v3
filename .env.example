# Ovaj fajl cita docker-compose.prod.yml (ne Laravel).
# Kopiraj u .env pored docker-compose.prod.yml na serveru.
#
# VAZNO: DB_DATABASE, DB_USERNAME i DB_PASSWORD moraju da se poklapaju sa
# istim vrednostima u pub-quiz-api/.env.prod. MySQL kreira korisnika prema
# ovom fajlu, a backend se prijavljuje prema onom drugom - ako se razlikuju,
# backend dobija "access denied" i kontejner pada u petlju.

DB_DATABASE=pubquiz
DB_USERNAME=pubquiz
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD
DB_ROOT_PASSWORD=CHANGE_ME_DIFFERENT_STRONG_PASSWORD
