# Svi tekst fajlovi dobijaju LF u repou
* text=auto eol=lf

# Dockerfiles i shell skripte moraju imati LF
Dockerfile* text eol=lf
*.sh text eol=lf
*.conf text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.md text eol=lf
*.php text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.jsx text eol=lf

# PowerShell skripte mogu imati CRLF (Windows)
*.ps1 text eol=crlf
