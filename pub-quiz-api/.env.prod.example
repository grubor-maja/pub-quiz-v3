APP_NAME=KozNazna
APP_ENV=production
# php artisan key:generate --show    (ili: docker compose exec backend php artisan key:generate)
APP_KEY=base64:GENERATE_ME
APP_DEBUG=false
APP_URL=https://koznazna.me
# Koristi se za link u mejlu za reset lozinke
FRONTEND_URL=https://koznazna.me

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# DB_HOST je naziv Docker servisa, ne localhost.
# DB_DATABASE/USERNAME/PASSWORD moraju biti ISTI kao u ../.env (compose fajl),
# inace backend ne moze da se poveze na bazu.
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=pubquiz
DB_USERNAME=pubquiz
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file

# Brevo (app.brevo.com -> SMTP & API -> SMTP).
# Port 2525, NE 587 - kod nekih hostinga je odlazni 587 blokiran pa slanje
# mejla istekne u timeout umesto da javi gresku.
MAIL_MAILER=smtp
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=2525
MAIL_USERNAME=CHANGE_ME
MAIL_PASSWORD=CHANGE_ME
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=no-reply@koznazna.me
MAIL_FROM_NAME="Ko Zna Zna"

CORS_ALLOWED_ORIGINS=https://koznazna.me

# Instagram scraping (apify.com -> Settings -> API tokens)
APIFY_TOKEN=CHANGE_ME
APIFY_ACTOR_ID=shu8hvrXbJbY3Eb9W
# Organizacije koje objave mesecni raspored pa posebnu objavu za svaki kviz
# trebaju vise od par desetina objava, inace vecina kvizova ostane bez slike.
APIFY_POST_LIMIT=60

# Gemini (aistudio.google.com -> Get API key)
GEMINI_API_KEY=CHANGE_ME
GEMINI_MODEL=gemini-flash-lite-latest
USE_AI_EXTRACTION=true

# Proizvoljna tajna za POST /api/instagram/sync
SYNC_API_KEY=CHANGE_ME_RANDOM_SECRET
