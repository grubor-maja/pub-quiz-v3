FROM php:8.3-apache

RUN a2enmod rewrite && \
    apt-get update && apt-get install -y \
    libpng-dev libonig-dev libxml2-dev libzip-dev \
    && docker-php-ext-install pdo_mysql mbstring exif pcntl bcmath gd zip \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

# No version banners: X-Powered-By: PHP/x.y.z and Apache's signature on its own
# error pages tell an attacker which known bugs to try. The zz- prefix makes
# this load after Debian's security.conf, which sets ServerTokens OS.
RUN echo "expose_php = Off" > /usr/local/etc/php/conf.d/zz-security.ini && \
    printf "ServerTokens Prod\nServerSignature Off\nTraceEnable Off\n" > /etc/apache2/conf-available/zz-hardening.conf && \
    a2enconf zz-hardening

COPY --from=composer:2.7 /usr/bin/composer /usr/bin/composer

WORKDIR /var/www/html

COPY pub-quiz-api/ .

# Ensure Laravel cache directories exist (may not be in git)
RUN mkdir -p bootstrap/cache storage/framework/cache/data storage/framework/sessions storage/framework/views storage/logs

RUN composer install --no-dev --optimize-autoloader --no-interaction

COPY docker/backend/apache.conf /etc/apache2/sites-available/000-default.conf

RUN chown -R www-data:www-data storage bootstrap/cache && \
    chmod -R 775 storage bootstrap/cache && \
    php artisan storage:link --quiet 2>/dev/null || true

EXPOSE 80
